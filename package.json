{
  "name": "34d-learning-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite --mode demo",
    "dev:supabase": "vite --mode local",
    "build": "tsc -b && vite build",
    "build:demo": "tsc -b && vite build --mode demo",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "cap:sync": "pnpm build && cap sync",
    "cap:add:ios": "cap add ios",
    "cap:add:android": "cap add android",
    "native:configure": "node scripts/configure-native.mjs"
  },
  "dependencies": {
    "@capacitor/app": "8.1.0",
    "@capacitor/core": "8.5.0",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/network": "8.0.1",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/splash-screen": "8.0.1",
    "@hookform/resolvers": "5.7.1",
    "@ionic/react": "8.8.17",
    "@ionic/react-router": "8.8.17",
    "@supabase/supabase-js": "2.112.2",
    "@tanstack/react-query": "5.101.4",
    "capacitor-secure-storage-plugin": "0.13.0",
    "ionicons": "8.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.85.0",
    "react-router": "5.3.4",
    "react-router-dom": "5.3.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/cli": "8.5.0",
    "@capacitor/ios": "8.5.0",
    "@eslint/js": "9.39.2",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.1",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.10.4",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@types/react-router": "5.1.20",
    "@types/react-router-dom": "5.3.3",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "16.5.0",
    "jsdom": "27.4.0",
    "prettier": "3.7.4",
    "typescript": "7.0.2",
    "typescript-eslint": "8.52.0",
    "vite": "8.2.1",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.10"
  },
  "pnpm": {
    "overrides": {
      "react-router": "5.3.4",
      "react-router-dom": "5.3.4"
    }
  }
}
